# BotModuleProject1 — environment template
# Copy to .env locally. Never commit .env.
# This file contains placeholders only. Do not put real tokens here.
#
# Public config is read ONLY from keys prefixed BOTMODULEPROJECT1_.
# Unprefixed TRADING_MODE / LIVE_TRADING_ENABLED / DATABASE_URL are ignored
# so ambient PaaS env cannot change posture (Sequence 02).

# --- public (prefix required) ---
BOTMODULEPROJECT1_APP__NAME=BotModuleProject1
BOTMODULEPROJECT1_APP__ENVIRONMENT=local
BOTMODULEPROJECT1_APP__DEFAULT_SYMBOL=EURUSD
BOTMODULEPROJECT1_SAFETY__TRADING_MODE=demo
BOTMODULEPROJECT1_SAFETY__LIVE_TRADING_ENABLED=false
BOTMODULEPROJECT1_PROFILE=demo
BOTMODULEPROJECT1_LOGGING__LEVEL=INFO

# feature flags — requires-review may be YAML; dangerous flags are env-only
BOTMODULEPROJECT1_FEATURE__ENABLE_PM2_MARKET_DATA=false
BOTMODULEPROJECT1_FEATURE__ENABLE_STRATEGY_ENGINE=false
BOTMODULEPROJECT1_FEATURE__ENABLE_FORECASTING=false
BOTMODULEPROJECT1_FEATURE__ENABLE_PM4_RISK_GATE=false
BOTMODULEPROJECT1_FEATURE__ENABLE_PM5_EXECUTION=false
BOTMODULEPROJECT1_FEATURE__ENABLE_TELEGRAM_CONTROL=false
BOTMODULEPROJECT1_FEATURE__ENABLE_FINE_TUNE_STUDIO=false
BOTMODULEPROJECT1_FEATURE__ENABLE_LIVE_TRADING=false

# --- secrets (empty placeholders; names only) ---
# MT5 Demo — never commit real values. Allowlisted unprefixed names.
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_TERMINAL_PATH=
BOTMODULEPROJECT1_MT5_LOGIN=
BOTMODULEPROJECT1_MT5_PASSWORD=
BOTMODULEPROJECT1_MT5_SERVER=
BOTMODULEPROJECT1_MT5_TERMINAL_PATH=

# Persistence (future PM8). NOT DATABASE_URL — that name is too common in PaaS.
BOTMODULEPROJECT1_DATABASE_URL=
BOTMODULEPROJECT1_POSTGRES_PASSWORD=

# Telegram operator transport (future PM9)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALLOWED_USER_IDS=
BOTMODULEPROJECT1_TELEGRAM_BOT_TOKEN=
BOTMODULEPROJECT1_TELEGRAM_CHAT_ID=
BOTMODULEPROJECT1_TELEGRAM_ALLOWED_USER_IDS=

# Optional model registry / object storage (future)
BOTMODULEPROJECT1_MODEL_REGISTRY_URI=
BOTMODULEPROJECT1_OBJECT_STORE_URI=
