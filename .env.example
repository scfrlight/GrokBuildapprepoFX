# BotModuleProject1 — environment template
# Copy to .env locally. Never commit .env.
# This file contains placeholders only. Do not put real tokens here.

# --- public (may also live in YAML) ---
APP_NAME=BotModuleProject1
ENVIRONMENT=local
TRADING_MODE=demo
LIVE_TRADING_ENABLED=false
DEFAULT_SYMBOL=EURUSD
LOG_LEVEL=INFO
TZ=UTC

# feature flags (all future capabilities default off)
FEATURE_STRATEGY_ENGINE=false
FEATURE_FORECASTING=false
FEATURE_RISK_ENGINE=false
FEATURE_EXECUTION=false
FEATURE_TELEGRAM=false
FEATURE_FINE_TUNE_STUDIO=false

# --- secrets (empty placeholders; names only) ---
# MT5 Demo — never commit real values
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_TERMINAL_PATH=

# Persistence (future PM8)
DATABASE_URL=
POSTGRES_PASSWORD=

# Telegram operator transport (future PM9)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALLOWED_USER_IDS=

# Optional model registry / object storage (future)
MODEL_REGISTRY_URI=
OBJECT_STORE_URI=
